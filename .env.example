APP_URL="MY_APP_URL"

# ENVIRONMENT: Controls which env file is loaded (.env.dev or .env.prod)
ENVIRONMENT="development"
NODE_ENV="development"
PORT="3000"

# Client-side Vite Environment Variables (initialized in src/config/environment.ts)
VITE_ENVIRONMENT="development"
VITE_APP_NAME="MILE-DEV"
VITE_APP_VERSION="1.0.0-dev"
VITE_API_BASE_URL="/api/v1"
VITE_API_TIMEOUT_MS="15000"
VITE_ENABLE_DEMO_AUTH="true"
VITE_LOG_LEVEL="debug"